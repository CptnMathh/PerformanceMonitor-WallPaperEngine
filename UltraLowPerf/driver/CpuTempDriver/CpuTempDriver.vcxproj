<?xml version="1.0" encoding="utf-8"?>
<!--
  CpuTempDriver.vcxproj  –  WDK 10.0.28000.0 new-style build
  ─────────────────────────────────────────────────────────────
  Requires:
    • Visual Studio 2022 v17+ or Insider v18  (MSVC v143/v180)
    • WDK 10.0.28000.0  (includes km/ headers + KMDF libs)
    • WindowsTargetPlatformVersion = 10.0.28000.0

  WDK 28000 dropped the old WindowsKernelModeDriver10.0 platform
  toolset.  The new approach imports WindowsDriver.Default.props
  BEFORE Microsoft.Cpp.Default.props, then WindowsDriver.Common.targets
  AFTER Microsoft.Cpp.targets.  ConfigurationType=Driver triggers the
  WDK MSBuild infrastructure.

  Build:
    msbuild CpuTempDriver.vcxproj /p:Configuration=Debug /p:Platform=x64
    Output: x64\Debug\CpuTempDriver.sys
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ── 1. Project configurations ───────────────────────────────────────── -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!-- ── 2. Global properties ─────────────────────────────────────────────── -->
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <RootNamespace>CpuTempDriver</RootNamespace>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <Configuration Condition="'$(Configuration)'==''">Debug</Configuration>
    <Platform       Condition="'$(Platform)'==''">x64</Platform>

    <!-- WDK 10.0.28000.0 -->
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
    <WindowsDriverTargetOsVersion>10.0.26100</WindowsDriverTargetOsVersion>
    <WDKBuildFolder>10.0.28000.0</WDKBuildFolder>

    <!-- WDKContentRoot resolved from registry (set by WDK installer) -->
    <WDKContentRoot>$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots@KitsRoot10)</WDKContentRoot>
    <WDKContentRoot Condition="'$(WDKContentRoot)'==''">$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Microsoft\Windows Kits\Installed Roots@KitsRoot10)</WDKContentRoot>
  </PropertyGroup>

  <!-- ── 3. WDK default props (MUST come before Cpp.Default.props) ─────── -->
  <Import Condition="Exists('$(WDKContentRoot)build\$(WDKBuildFolder)\WindowsDriver.Default.props')"
          Project="$(WDKContentRoot)build\$(WDKBuildFolder)\WindowsDriver.Default.props" />

  <!-- ── 4. Standard MSVC default props ───────────────────────────────────── -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- ── 5. Per-configuration settings ────────────────────────────────────── -->
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Debug'">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries>true</UseDebugLibraries>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
    <!-- DDKPlatform: normally injected by WDK.x64.WindowsKernelModeDriver.props;
         set explicitly here so DDK_LIB_PATH resolves to km\x64\ correctly. -->
    <DDKPlatform>x64</DDKPlatform>
    <KmdfVersion>1.33</KmdfVersion>
    <!-- Disable MSBuild auto test-signing for local development.
         Sign manually: signtool sign /fd sha256 /a CpuTempDriver.sys  -->
    <EnableTestSign>false</EnableTestSign>
    <SignFile>false</SignFile>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Release'">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
    <DDKPlatform>x64</DDKPlatform>
    <KmdfVersion>1.33</KmdfVersion>
  </PropertyGroup>

  <!-- ── 6. Standard MSVC props ────────────────────────────────────────────── -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- ── 6a. WDK driver props via orchestrator (must follow Cpp.props)
       WDK.x64.WindowsKernelModeDriver.Platform.props imports in order:
         WDK.props (km/shared/KMDF include & lib paths)
         WindowsDriver.common.props  (Shared → OS.props → Valid_NTTARGETVERSIONS)
         WindowsDriver.KernelMode.Default.props  (SPB / KMDF version defaults)
         WindowsDriver.KernelMode.props          (.sys output, /kernel flag, lib deps)
         WindowsDriver.KernelMode.LateEvaluation.props  (KMDF_VER_PATH, IncludePath)
         WindowsDriver.LateEvaluation.props
       All guarded by IsKernelModeToolset == true.  ─────────────────────────────── -->
  <PropertyGroup>
    <IsKernelModeToolset>true</IsKernelModeToolset>
  </PropertyGroup>
  <Import Condition="Exists('$(WDKContentRoot)DesignTime\CommonConfiguration\Neutral\WDK\$(WDKBuildFolder)\WDK.props')"
          Project="$(WDKContentRoot)DesignTime\CommonConfiguration\Neutral\WDK\$(WDKBuildFolder)\WDK.props" />
  <Import Condition="Exists('$(WDKContentRoot)build\$(WDKBuildFolder)\x64\ImportAfter\WDK.x64.WindowsKernelModeDriver.Platform.props')"
          Project="$(WDKContentRoot)build\$(WDKBuildFolder)\x64\ImportAfter\WDK.x64.WindowsKernelModeDriver.Platform.props" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <!-- Override WDK auto-sign for Debug: KernelMode.props unconditionally sets
       EnableTestSign=true for ConfigurationType=Driver.  Force it off here
       (after all imports) so the .sys is not deleted by RemoveUnsignedOutput.
       To deploy: run  signtool sign /fd sha256 /a x64\Debug\CpuTempDriver.sys  -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <EnableTestSign>false</EnableTestSign>
    <SignMode></SignMode>
    <!-- Skip .cat catalog generation in Debug (not needed until deployment) -->
    <EnableInf2cat>false</EnableInf2cat>
  </PropertyGroup>

  <PropertyGroup Label="UserMacros" />

  <!-- ── 7. Build settings ─────────────────────────────────────────────────── -->
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
      <!-- IntDir  : generated headers (e.g. stamped INF version header)
           KMDF    : wdf.h, wdfdriver.h, wdfrequest.h …
           shared  : warning.h (forced-include by WDK Shared.props)           -->
      <AdditionalIncludeDirectories>$(IntDir);$(KMDF_INC_PATH)$(KMDF_VERSION_MAJOR).$(KMDF_VERSION_MINOR);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_WIN64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- C4996: HalGetBusDataByOffset is deprecated in WDK 28000 but used in
           placeholder probe code.  Suppress here; remove when real SMU code lands. -->
      <DisableSpecificWarnings>4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(DDK_LIB_PATH)wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- ── 8. Source files ───────────────────────────────────────────────────── -->
  <ItemGroup>
    <ClCompile Include="CpuTempDriver.c" />
    <ClCompile Include="TempBackend.c" />
    <ClCompile Include="AmdSmuBackend.c" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="ioctl.h" />
    <ClInclude Include="TempBackend.h" />
    <ClInclude Include="AmdSmuBackend.h" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="CpuTempDriver.inf">
      <CopyOutput>$(IntDir)CpuTempDriver.inf</CopyOutput>
      <KmdfVersionNumber>1.33</KmdfVersionNumber>
      <SpecifyArchitecture>true</SpecifyArchitecture>
      <Architecture>x64</Architecture>
    </Inf>
  </ItemGroup>

  <!-- ── 9. Standard MSVC targets ──────────────────────────────────────────── -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- ── 10. WDK common targets (MUST come after Cpp.targets) ─────────────── -->
  <ImportGroup Label="ExtensionTargets">
    <Import Condition="Exists('$(WDKContentRoot)build\$(WDKBuildFolder)\WindowsDriver.Common.targets')"
            Project="$(WDKContentRoot)build\$(WDKBuildFolder)\WindowsDriver.Common.targets" />
  </ImportGroup>

</Project>
